# Example environment file — copy to .env and fill in.
# NEVER commit the real .env (see .gitignore).
# Project: msarchive — Author: Vaibhav (Vaibhav Agarwal, archiver)
# https://github.com/thisisforlearn/archive | GPL-3.0-only

# --- Internet Archive (keys from https://archive.org/account/s3.php) ---
IA_S3_ACCESS_KEY=
IA_S3_SECRET_KEY=

# --- Hugging Face (token with write access to the dataset repo below) ---
HF_TOKEN=
# Public mirror repo (also the hourly progress ledger)
MSARCHIVE_HF_REPO_ID=thisisforlearn/vaibhav-music-archive

# --- Run knobs ---
# Permissive policies: permissive (default, name-based), strict (name AND flags),
# flags, all (not recommended)
MSARCHIVE_POLICY=permissive
# Hourly checkpoint interval in seconds (Kaggle: 3600 = every 1h)
MSARCHIVE_CHECKPOINT_EVERY=3600
# Archiver credit burned into every upload
MSARCHIVE_ARCHIVIST_NAME=Vaibhav Agarwal (archiver)
MSARCHIVE_ARCHIVIST_EMAIL=nekomeowpurr@proton.me
MSARCHIVE_ARCHIVIST_GITHUB=https://github.com/thisisforlearn/archive

# --- Optional: Internet Archive item naming / collection ---
MSARCHIVE_IA_COLLECTION=opensource_audio
MSARCHIVE_IA_ITEM_PREFIX=vaibhav-archive-music
MSARCHIVE_IA_MAX_FILES=1000

# --- Optional: secondary source (Jamendo; needs a client id) ---
# JAMENDO_CLIENT_ID=

# --- Source override (FMA full mirror used by default) ---
# MSARCHIVE_HF_SOURCE=benjamin-paine/free-music-archive-full
